# Copy to .env (git-ignored) and fill in. Never commit .env.

# Trading mode: BACKTEST | SHADOW | DEMO | LIVE. Only DEMO and LIVE may ever send orders,
# and LIVE additionally needs the acknowledgement below AND configs/promotion.yaml sign-off.
AURUM_MODE=BACKTEST

# Optional overrides. Defaults: Windows -> C:\aurum-data, macOS -> ./data
# AURUM_DATA_DIR=
# AURUM_CONFIG_DIR=
# Backtest runs (default: <repo>/reports/runs)
# AURUM_RUNS_DIR=

# Leave unset. Live trading is out of scope for v1.
# AURUM_LIVE_ACK=

# MetaTrader 5 demo credentials (Windows VM only)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: full path to terminal64.exe if more than one MT5 terminal is installed
# MT5_PATH=C:\Program Files\Fusion Markets MetaTrader 5\terminal64.exe
